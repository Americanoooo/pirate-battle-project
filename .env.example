# All variables are optional; defaults are shown.

# Base URL of the ranking/history API. The MSW mock intercepts /api in every environment.
VITE_API_BASE_URL=/api

# Axios timeout in milliseconds (tests override it with ?apiTimeout=ms).
VITE_API_TIMEOUT_MS=8000

# Set to "false" to disable the MSW mock API (e.g. when pointing at a real backend).
VITE_ENABLE_MOCKS=true
